// Whisper Subtitler - Windows resources (icon + version info)
// Compiled with: x86_64-w64-mingw32-windres launcher.rc -O coff -o build/launcher.res

IDI_ICON1 ICON "assets/WhisperSubtitler.ico"

// Language 0x0409 (English US) + UTF-8; provides version details in Explorer.
1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Whisper Subtitler"
            VALUE "FileDescription",  "Whisper Subtitler"
            VALUE "FileVersion",      "1.0"
            VALUE "InternalName",     "WhisperSubtitler"
            VALUE "OriginalFilename", "WhisperSubtitler.exe"
            VALUE "ProductName",      "Whisper Subtitler"
            VALUE "ProductVersion",   "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END